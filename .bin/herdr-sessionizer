#! /bin/bash

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(find ~/ ~/repos ~/nuvia ~/eager -mindepth 1 -maxdepth 1 -type d | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected=$(realpath "$selected")
selected_name=$(basename "$selected")

# No herdr server running and not inside herdr: start herdr in the selected dir
if [[ -z $HERDR_ENV ]] && ! herdr status server > /dev/null 2>&1; then
    cd "$selected" && exec herdr
fi

find_workspace() {
    herdr workspace list 2> /dev/null |
        jq -r --arg name "$selected_name" \
            '.result.workspaces[] | select(.label == $name) | .workspace_id' |
        head -n1
}

workspace_id=$(find_workspace)

if [[ -z $workspace_id ]]; then
    herdr workspace create --cwd "$selected" --label "$selected_name" --no-focus > /dev/null
    workspace_id=$(find_workspace)
fi

herdr workspace focus "$workspace_id" > /dev/null

if [[ -z $HERDR_ENV ]]; then
    exec herdr
fi
